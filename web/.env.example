# Copy this file to .env.local and fill in the first line. .env.local is never committed.

# Required for "Ask the Lab". Any OpenAI-compatible endpoint with tool calling works.
# Free Groq key: https://console.groq.com/keys
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile

# Optional: questions the whole site may ask per day (default 300).
ASK_DAILY_LIMIT=300

# Optional but recommended once deployed: makes the limits above hold across all Vercel servers.
# Free database at https://console.upstash.com (Redis > Create > REST API section).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
